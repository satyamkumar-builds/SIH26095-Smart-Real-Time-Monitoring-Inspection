<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_sync_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Card Header Row: Inspection ID & Priority Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_sync_inspection_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="INS-2026-1042"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sync_priority_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_priority_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="HIGH PRIORITY"
            android:textColor="#1976D2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Inspection Title -->
    <TextView
        android:id="@+id/tv_sync_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Facility Inspection"
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- Captured Evidence Image Thumbnail -->
    <ImageView
        android:id="@+id/img_sync_evidence_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:background="#F0F0F0"
        android:clipToOutline="true"
        android:contentDescription="Evidence Thumbnail"
        android:scaleType="centerCrop" />

    <!-- Details Section: Location, Time & Image File Size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <!-- Location Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Location Icon"
                android:src="@drawable/ic_location" />

            <TextView
                android:id="@+id/tv_sync_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="District 4, Main Utility Plant"
                android:textColor="#666666"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Time Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Time Icon"
                android:src="@drawable/ic_time" />

            <TextView
                android:id="@+id/tv_sync_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="09:15:30 AM IST"
                android:textColor="#666666"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thin Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#E0E0E0" />

    <!-- Bottom Action Row: Delete & Sync Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <!-- White Delete Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_delete_sync_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_delete_button"
            android:drawableLeft="@drawable/ic_delete"
            android:paddingHorizontal="16dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Blue Sync Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_upload_sync_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_sync_button"
            android:drawableLeft="@drawable/ic_cloud_sync"
            android:paddingHorizontal="16dp"
            android:text="Sync"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
