<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- STILL TOPBAR SPECIFIC TO TASKS PAGE -->
    <RelativeLayout
        android:id="@+id/topbar_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Left Side Container: Greeting and Status -->
        <LinearLayout
            android:id="@+id/left_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/right_actions_container"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Morning, Rahul"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_online_dot" />

                <TextView
                    android:id="@+id/tv_user_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online - Sync Pending"
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side Container: Notification & Profile DP -->
        <LinearLayout
            android:id="@+id/right_actions_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/btn_notification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/img_notification_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_notification" />

                <View
                    android:id="@+id/view_notification_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_alignTop="@id/img_notification_icon"
                    android:layout_alignRight="@id/img_notification_icon"
                    android:layout_marginTop="-1dp"
                    android:layout_marginRight="-1dp"
                    android:background="@drawable/bg_notification_dot"
                    android:visibility="visible" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/img_profile_dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_profile_circle"
                android:clickable="true"
                android:contentDescription="Profile Picture"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_profile" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MAIN SCROLLABLE CONTENT AREA (TOPBAR STAYS STILL AT TOP) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topbar_tasks"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. PREVIOUS ROOT CONTAINER: STATUS GRID & START BUTTON -->
            <LinearLayout
                android:id="@+id/module_status_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <GridLayout
                    android:id="@+id/grid_status_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <RelativeLayout
                        android:id="@+id/card_assigned"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_status_card"
                        android:elevation="2dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_title_assigned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:text="ASSIGNED"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/img_icon_assigned"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentTop="true"
                            android:contentDescription="Assigned Icon"
                            android:src="@drawable/ic_assigned" />

                        <TextView
                            android:id="@+id/tv_count_assigned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentBottom="true"
                            android:text="8"
                            android:textColor="#1A1A1A"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_in_progress"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_status_card"
                        android:elevation="2dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_title_in_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:text="IN PROGRESS"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/img_icon_in_progress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentTop="true"
                            android:contentDescription="In Progress Icon"
                            android:src="@drawable/ic_in_progress" />

                        <TextView
                            android:id="@+id/tv_count_in_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentBottom="true"
                            android:text="5"
                            android:textColor="#1A1A1A"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_completed"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_status_card"
                        android:elevation="2dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_title_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:text="COMPLETED"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/img_icon_completed"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentTop="true"
                            android:contentDescription="Completed Icon"
                            android:src="@drawable/ic_completed" />

                        <TextView
                            android:id="@+id/tv_count_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentBottom="true"
                            android:text="24"
                            android:textColor="#1A1A1A"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/card_overdue"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_red_status_card"
                        android:elevation="2dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_title_overdue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:text="OVERDUE"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/img_icon_overdue"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentTop="true"
                            android:contentDescription="Overdue Icon"
                            android:src="@drawable/ic_overdue" />

                        <TextView
                            android:id="@+id/tv_count_overdue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentBottom="true"
                            android:text="2"
                            android:textColor="#1A1A1A"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </GridLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_start_inspection"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="Start Inspection"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. NEW ROOT CONTAINER: TODAY'S INSPECTION MODULE -->
            <LinearLayout
                android:id="@+id/root_todays_inspections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingBottom="24dp">

                <!-- Header Left Aligned -->
                <TextView
                    android:id="@+id/tv_header_todays_inspections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Today's Inspections"
                    android:textColor="#1A1A1A"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Dynamic Container where JSON Cards are inflated -->
                <LinearLayout
                    android:id="@+id/container_inspection_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
