<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TOPBAR SPECIFIC TO CAPTURE PAGE -->
    <RelativeLayout
        android:id="@+id/topbar_capture"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <!-- Cross 'X' Button at Left -->
        <ImageView
            android:id="@+id/btn_close_capture"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_close" />

        <!-- Title in Middle: 'Capture Evidence' -->
        <TextView
            android:id="@+id/tv_title_capture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Capture Evidence"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 'Done' Button at Right (Greyed out initially) -->
        <TextView
            android:id="@+id/btn_done_capture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:clickable="false"
            android:padding="6dp"
            android:text="Done"
            android:textColor="#9E9E9E"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- MAIN CAMERA VIEW AREA (STRETCHES FULL SCREEN BELOW TOPBAR) -->
    <RelativeLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_camera_controls"
        android:layout_below="@id/topbar_capture">

        <!-- Live Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Captured Image Preview (Shown after taking photo) -->
        <ImageView
            android:id="@+id/img_captured_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- TOP LEFT: Inspection ID Overlay Box -->
        <TextView
            android:id="@+id/tv_overlay_inspection_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_translucent_badge"
            android:text="ID: INS-2026-1042"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- TOP RIGHT: Live IST Time Overlay Box -->
        <TextView
            android:id="@+id/tv_overlay_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_translucent_badge"
            android:text="09:00:00 AM IST"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- BOTTOM LEFT: Lat & Long Location Overlay Box -->
        <TextView
            android:id="@+id/tv_overlay_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_translucent_badge"
            android:text="Lat: --, Long: --"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- BOTTOM CAMERA CONTROLS BAR -->
    <RelativeLayout
        android:id="@+id/bottom_camera_controls"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:paddingHorizontal="24dp">

        <!-- LEFT CONTROL: Location Toggle (or Discard 'X' when captured) -->
        <ImageView
            android:id="@+id/btn_left_control"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Location"
            android:focusable="true"
            android:src="@drawable/ic_location" />

        <!-- MIDDLE CONTROL: Shutter Capture Button -->
        <ImageView
            android:id="@+id/btn_shutter"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_centerInParent="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Take Photo"
            android:focusable="true"
            android:src="@drawable/ic_shutter" />

        <!-- RIGHT CONTROL: Camera Flip (or Save to Gallery when captured) -->
        <ImageView
            android:id="@+id/btn_right_control"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Flip Camera"
            android:focusable="true"
            android:src="@drawable/ic_flip_camera" />

    </RelativeLayout>

</RelativeLayout>
